+    private static long emberTargetKey(final java.util.Set<net.minecraft.core.BlockPos> targets) {
+        // A coarse (4-block) key on one representative target: repeated attempts to
+        // essentially the same unreachable spot share a key; a real move resets it.
+        for (final net.minecraft.core.BlockPos t : targets) {
+            long k = (t.getX() >> 2);
+            k = k * 31 + (t.getY() >> 2);
+            k = k * 31 + (t.getZ() >> 2);
+            return k;
+        }
+        return Long.MIN_VALUE;
+    }
